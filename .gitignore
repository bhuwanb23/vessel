# =============================================================================
# Local LLM Planner - .gitignore
# =============================================================================

# ------------------------------------
# llama.cpp (cloned dependency)
# ------------------------------------
llama.cpp/

# ------------------------------------
# Build artifacts
# ------------------------------------
build/
build_*/
out/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
install_manifest.txt

# Compiled binaries
*.exe
*.obj
*.o
*.so
*.dylib
*.lib
*.dll
*.a

# CUDA build intermediates
*.cu.o
*.cubin
*.ptx

# ------------------------------------
# Model files (large, tracked separately)
# ------------------------------------
models/
*.gguf
*.safetensors
*.bin
*.ckpt
*.pt
*.pth

# ------------------------------------
# IDE / Editor files
# ------------------------------------
# VS Code
.vscode/
*.code-workspace

# Visual Studio
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.userosscache
*.sln.docstates

# CLion / JetBrains
.idea/
*.iml
cmake-build-*/

# Vim / Neovim
*.swp
*.swo
*~
tags
tags.lock

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# ------------------------------------
# OS files
# ------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# ------------------------------------
# Python (for gguf conversion scripts)
# ------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
*.egg
.venv/
venv/
env/

# ------------------------------------
# Documentation build artifacts
# ------------------------------------
docs/_build/
docs/_static/

# ------------------------------------
# Calibration logs and runtime data
# ------------------------------------
*.log
logs/
data/
*.json
!docs/*.json


*.zip
external/